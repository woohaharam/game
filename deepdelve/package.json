{
  "name": "deepdelve",
  "version": "0.1.0",
  "private": true,
  "description": "An idle fantasy dungeon RPG for the browser, built for web game portals.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "~5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
