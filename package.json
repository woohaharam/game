{
  "name": "pebble",
  "version": "0.1.0",
  "private": true,
  "description": "An idle growing game: turn a grain of sand into a galaxy, in the browser.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "smoke": "node tools/smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "balance": "vite-node tools/probe.ts",
    "build:crazygames": "npm run typecheck && DD_PORTAL=crazygames vite build",
    "build:poki": "npm run typecheck && DD_PORTAL=poki vite build",
    "package": "node tools/package.mjs",
    "package:crazygames": "node tools/package.mjs crazygames",
    "package:poki": "node tools/package.mjs poki",
    "ladder": "node tools/ladder.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
